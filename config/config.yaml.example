# Winnow configuration
accounts:
  - email: you@example.com
    channel: C0PERSONAL_EMAIL
    # Optional UI/push identity and Gmail iOS account slot (first Gmail account is 1).
    avatar_url: https://example.com/your-account-avatar.png
    gmail_app_account_id: 1
    # Optional additional receiving addresses for this mailbox. Replies/forwards
    # use the addressed alias only when Gmail lists it as a verified send-as.
    # An unverified listed alias produces an explicit setup error, not fallback
    # to the primary mailbox. Addresses here do NOT configure Google routing.
    # receiving_aliases: [info@your-brand.example, support@another-brand.example]
    # For a retired/renamed source mailbox, keep its existing email key/IDs and
    # route read-only history access to its current gog-authenticated identity:
    # auth_account: legacy@example.com
    # read_only: true
    # sync_enabled: false

  # Optional: route one Gmail account to a different Slack workspace/app.
  # Keep tokens in .env and reference their variable names here.
  - email: work@example.com
    slack:
      channel_id: C0WORK_EMAIL
      bot_token_env: WORK_SLACK_BOT_TOKEN
      app_token_env: WORK_SLACK_APP_TOKEN

# Gmail adapter: "gog" (default) or "google-workspace" (future)
adapter: gog

# Slack notifications
slack:
  # Master switch for Slack feed delivery and Socket Mode action listeners.
  enabled: true
  # Set SLACK_BOT_TOKEN and SLACK_APP_TOKEN in .env (preferred) or put tokens here.
  # Account-level slack.bot_token_env/app_token_env overrides these for separate workspaces.
  bot_token: ""
  app_token: ""
  channel_id: "YOUR_CHANNEL_ID"
  # all = keep current Slack feed behavior; kept = only inbox-worthy emails; off = no Slack feed
  feed_mode: all

# Private API for the personal iOS app
# Keep this loopback-only; use Tailscale Serve HTTPS for physical-device access.
# Set WINNOW_API_TOKEN in .env. The same token protects /v1/* and /mcp.
api:
  host: 127.0.0.1
  port: 3777

daemon:
  scan_interval_seconds: 30

reconcile:
  interval_seconds: 300

# AI model configuration (uses GEMINI_API_KEY env var)
model:
  classification_name: gemini-3.1-flash-lite
  assistant_name: gemini-3.5-flash

# Scan settings
scan:
  max_messages: 50
  search_query: "in:inbox is:unread newer_than:1d"
